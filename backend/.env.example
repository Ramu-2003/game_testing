PORT=3000
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster.mongodb.net/game-db?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
EMAIL_FROM=your@email.com
GMAIL_USER=your@email.com
GMAIL_PASS=your_gmail_app_password
FRONTEND_URL=http://localhost:5173
# Competitive season settings; RP resets to the configured carryover at rollover.
TOURNAMENT_SEASON_DAYS=90
TOURNAMENT_RP_CARRYOVER=0.5
# Optional comma-separated list for production previews or additional frontends.
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# GROQ API KEYS — ONE variable, comma-separated, unlimited keys supported
# Get keys from: https://console.groq.com/keys
#
# LOCAL (.env):
#   GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
#
# RENDER DASHBOARD:
#   Key:   GROQ_API_KEYS
#   Value: gsk_key1,gsk_key2,gsk_key3,...,gsk_key100
#
# To add more keys: just append ,gsk_newkey to the value. No code changes.
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEYS=gsk_YOUR_KEY_1,gsk_YOUR_KEY_2,gsk_YOUR_KEY_3

# Optional isolated execution service. Keep it on a private network; use a
# random shared secret of at least 32 bytes and do not expose the runner publicly.
CODE_RUNNER_URL=http://127.0.0.1:3010
CODE_RUNNER_SECRET=replace_with_a_random_secret_at_least_32_bytes
